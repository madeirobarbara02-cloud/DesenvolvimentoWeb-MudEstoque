        AppbarText         = "#1E293B",
        DrawerBackground   = "#FFFFFF",
        DrawerText         = "#374151",
        DrawerIcon         = "#6B7280",
        Black              = "#1E293B",
        TextPrimary        = "#1E293B",
        TextSecondary      = "#64748B",
        TextDisabled       = "#CBD5E1",
        ActionDefault           = "#64748B",
        ActionDisabled          = "#94A3B84D",
        ActionDisabledBackground= "#F1F5F9",
        Divider            = "#E2E8F0",
        DividerLight       = "#F1F5F9",
        TableLines         = "#E2E8F0",
        LinesDefault       = "#E2E8F0",
        LinesInputs        = "#CBD5E1",
        GrayLight          = "#F1F5F9",
        GrayLighter        = "#F8FAFC",
