@inherits LayoutComponentBase
@inject IJSRuntime JS

<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true"
               Style="border-bottom: 1px solid var(--mud-palette-divider);">

        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       Size="Size.Small"
                       OnClick="DrawerToggle" />

        @if (!_drawerOpen)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="ml-2">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2"
                         Color="Color.Primary"
                         Size="Size.Small" />
                <MudText Typo="Typo.subtitle1" Color="Color.Inherit"
                         Style="font-weight:600; letter-spacing:-0.3px;">
                    MudEstoque
                </MudText>
            </MudStack>
        }

        <MudSpacer />

        <MudTooltip Text="@(_isDarkMode ? "Mudar para tema claro" : "Mudar para tema escuro")"
                    Placement="Placement.Bottom">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit"
                           Size="Size.Small"
                           OnClick="ToggleDarkModeAsync" />
        </MudTooltip>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Elevation="0"
               Style="border-right: 1px solid var(--mud-palette-divider);">
        <MudDrawerHeader Dense="true" Style="padding: 10px 16px;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2"
                         Color="Color.Primary"
                         Size="Size.Medium" />
                <MudText Typo="Typo.subtitle1"
                         Style="font-weight:700; letter-spacing:-0.2px;">
                    MudEstoque
                </MudText>
            </MudStack>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="pt-16 pa-4">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode  = true;
    private MudTheme _theme   = null!;

    protected override void OnInitialized()
    {
        _theme = new MudTheme()
        {
            PaletteLight = _lightPalette,
            PaletteDark  = _darkPalette,
            LayoutProperties = new LayoutProperties()
            {
                DrawerWidthLeft = "240px",
                AppbarHeight    = "48px",
                DefaultBorderRadius = "6px"
            }
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                string saved = await JS.InvokeAsync<string>("mudEstoque.getTheme");
                bool prefersDark = saved != "light";
                if (_isDarkMode != prefersDark)
                {
                    _isDarkMode = prefersDark;
                    StateHasChanged();
                }
            }
            catch
            {
            }
        }
    }

    private async Task ToggleDarkModeAsync()
    {
        _isDarkMode = !_isDarkMode;
        try
        {
            await JS.InvokeVoidAsync("mudEstoque.setTheme", _isDarkMode ? "dark" : "light");
        }
        catch { }
    }

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;

    // ── TEMA CLARO ─────────────────────────────────────────────────────────────
