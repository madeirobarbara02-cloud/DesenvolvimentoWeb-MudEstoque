@inject IFornecedorService FornecedorService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@(_viewModel.EmEdicao ? Icons.Material.Outlined.Edit : Icons.Material.Outlined.AddBusiness)"
                     Color="Color.Primary"
                     Size="Size.Small" />
            <MudText Typo="Typo.h6">
                @(_viewModel.EmEdicao ? "Editar Fornecedor" : "Novo Fornecedor")
            </MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        @if (_editContext is null)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
        }
        else
        {
            <EditForm EditContext="_editContext" OnValidSubmit="SalvarAsync">
                <DataAnnotationsValidator />

                <MudGrid Spacing="2">
                    <MudItem xs="12" md="8">
                        <MudTextField Label="Razão Social"
                                      @bind-Value="_viewModel.RazaoSocial"
                                      For="@(() => _viewModel.RazaoSocial)"
                                      MaxLength="200"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudTextField Label="CNPJ"
                                      @bind-Value="_viewModel.CNPJ"
                                      For="@(() => _viewModel.CNPJ)"
                                      MaxLength="18"
                                      Placeholder="00.000.000/0000-00"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField Label="E-mail"
                                      @bind-Value="_viewModel.Email"
                                      For="@(() => _viewModel.Email)"
                                      MaxLength="200"
                                      Placeholder="contato@empresa.com"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField Label="Telefone"
                                      @bind-Value="_viewModel.Telefone"
                                      For="@(() => _viewModel.Telefone)"
                                      MaxLength="20"
                                      Placeholder="(00) 00000-0000"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField Label="Endereço"
                                      @bind-Value="_viewModel.Endereco"
                                      For="@(() => _viewModel.Endereco)"
                                      Lines="2"
                                      MaxLength="300"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudCheckBox @bind-Value="_viewModel.Ativo"
                                     Label="Fornecedor ativo"
                                     Color="Color.Primary"
                                     Dense="true" />
                    </MudItem>
                </MudGrid>
            </EditForm>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancelar"
                   Disabled="_salvando"
                   Size="Size.Small">
            Cancelar
        </MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Size="Size.Small"
                   Disabled="@(_salvando || _editContext is null)"
                   OnClick="SalvarAsync">
            @if (_salvando)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <span class="ms-2">Salvando...</span>
            }
            else
            {
                <span>Salvar</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public int Id { get; set; }

    private FornecedorViewModel _viewModel = new();
    private EditContext? _editContext;
    private bool _salvando;

    protected override async Task OnInitializedAsync()
    {
        if (Id != 0)
        {
            Fornecedor? fornecedor = await FornecedorService.ObterPorIdAsync(Id);
            if (fornecedor is null)
            {
                Snackbar.Add("Este fornecedor não existe mais.", Severity.Warning);
                MudDialog.Cancel();
                return;
            }

            _viewModel = FornecedorViewModel.DaEntidade(fornecedor);
        }

        _editContext = new EditContext(_viewModel);
    }

    private async Task SalvarAsync()
    {
        if (_editContext is null || _salvando || !_editContext.Validate()) return;

        _salvando = true;
        try
        {
            Fornecedor fornecedor = _viewModel.ParaEntidade();

            if (_viewModel.EmEdicao)
            {
                bool alterou = await FornecedorService.AlterarAsync(fornecedor);
                if (!alterou)
                {
                    Snackbar.Add("Este fornecedor não existe mais.", Severity.Warning);
                    MudDialog.Cancel();
                    return;
                }
                Snackbar.Add("Fornecedor atualizado com sucesso!", Severity.Success);
            }
            else
            {
                await FornecedorService.AdicionarAsync(fornecedor);
                Snackbar.Add("Fornecedor cadastrado com sucesso!", Severity.Success);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Erro ao salvar: " + ex.Message, Severity.Error);
        }
        finally
        {
            _salvando = false;
        }
    }

    private void Cancelar() => MudDialog.Cancel();
}
