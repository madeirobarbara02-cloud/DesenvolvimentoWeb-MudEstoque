@page "/"

<PageTitle>MudEstoque — Painel</PageTitle>

<MudStack Spacing="1" Class="mb-5">
    <MudText Typo="Typo.h5">Painel</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary">
        Bem-vindo ao MudEstoque — controle de estoque simples e eficiente.
    </MudText>
</MudStack>

<MudGrid Spacing="3">

    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="0" Style="border: 1px solid var(--mud-palette-divider);">
            <MudCardContent Class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large"
                               Style="border-radius:10px;">
                        <MudIcon Icon="@Icons.Material.Filled.Category" />
                    </MudAvatar>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Categorias</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Organize os tipos de produtos
                        </MudText>
                    </MudStack>
                </MudStack>
            </MudCardContent>
            <MudCardActions Class="px-4 pb-3 pt-0">
                <MudButton Href="/categorias"
                           Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           EndIcon="@Icons.Material.Filled.ArrowForward">
                    Acessar
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="0" Style="border: 1px solid var(--mud-palette-divider);">
            <MudCardContent Class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudAvatar Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Large"
                               Style="border-radius:10px;">
                        <MudIcon Icon="@Icons.Material.Filled.BusinessCenter" />
                    </MudAvatar>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Fornecedores</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Gerencie seus fornecedores
                        </MudText>
                    </MudStack>
                </MudStack>
            </MudCardContent>
            <MudCardActions Class="px-4 pb-3 pt-0">
                <MudButton Href="/fornecedores"
                           Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           EndIcon="@Icons.Material.Filled.ArrowForward">
                    Acessar
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="0" Style="border: 1px solid var(--mud-palette-divider); opacity:.7;">
            <MudCardContent Class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudAvatar Color="Color.Success" Variant="Variant.Filled" Size="Size.Large"
                               Style="border-radius:10px;">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory" />
                    </MudAvatar>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Produtos</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Controle seu estoque
                        </MudText>
                    </MudStack>
                </MudStack>
            </MudCardContent>
            <MudCardActions Class="px-4 pb-3 pt-0">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                         Color="Color.Default" Icon="@Icons.Material.Filled.Schedule">
                    Em breve
                </MudChip>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="0" Style="border: 1px solid var(--mud-palette-divider); opacity:.7;">
            <MudCardContent Class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudAvatar Color="Color.Warning" Variant="Variant.Filled" Size="Size.Large"
                               Style="border-radius:10px;">
                        <MudIcon Icon="@Icons.Material.Filled.SwapVert" />
                    </MudAvatar>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Movimentações</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Entradas e saídas de estoque
                        </MudText>
                    </MudStack>
                </MudStack>
            </MudCardContent>
            <MudCardActions Class="px-4 pb-3 pt-0">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                         Color="Color.Default" Icon="@Icons.Material.Filled.Schedule">
                    Em breve
                </MudChip>
            </MudCardActions>
        </MudCard>
    </MudItem>

</MudGrid>
