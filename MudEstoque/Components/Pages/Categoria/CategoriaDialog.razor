@using MudEstoque.Services.Interfaces
@using MudEstoque.ViewModels
@using MudEstoque.Models
@inject ICategoriaService CategoriaService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (_editContext is null)
        {
            @* Enquanto busca a categoria no banco, o EditForm ainda não tem EditContext *@
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        }
        else
        {
            <EditForm EditContext="_editContext" OnValidSubmit="SalvarAsync">
                <DataAnnotationsValidator />

                <MudTextField Label="Nome"
                              @bind-Value="_viewModel.Nome"
                              For="@(() => _viewModel.Nome)"
                              MaxLength="100"
                              Variant="Variant.Outlined"
                              Class="mb-4" />

                <MudTextField Label="Descrição"
                              @bind-Value="_viewModel.Descricao"
                              For="@(() => _viewModel.Descricao)"
                              Lines="3"
                              MaxLength="500"
                              Variant="Variant.Outlined"
                              Class="mb-4" />

                <MudCheckBox @bind-Value="_viewModel.Ativo"
                             Label="Ativa"
                             Color="Color.Primary" />
            </EditForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_salvando" OnClick="SalvarAsync">
            @if (_salvando)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <span class="ms-2">Salvando...</span>
            }
            else
            {
                <span>Salvar</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    // Id recebido da lista: 0 = nova categoria; outro valor = edição
    [Parameter]
    public int Id { get; set; }

    private CategoriaViewModel _viewModel = new CategoriaViewModel();
    private EditContext? _editContext;
    private bool _salvando;

    // Prepara o formulário: vazio para incluir, ou com os dados atuais do banco para editar
    protected override async Task OnInitializedAsync()
    {
        if (Id != 0)
        {
            Categoria? categoria = await CategoriaService.ObterPorIdAsync(Id);
            if (categoria == null)
            {
                Snackbar.Add("Esta categoria não existe mais.", Severity.Warning);
                MudDialog.Cancel();
                return;
            }

            _viewModel = CategoriaViewModel.DaEntidade(categoria);
        }

        _editContext = new EditContext(_viewModel);
    }

    // Valida e salva; chamado pelo botão Salvar e pelo Enter no formulário
    private async Task SalvarAsync()
    {
        // _salvando barra a segunda chamada (dois Enter, ou Enter e clique)
        if (_editContext == null || _salvando || !_editContext.Validate())
        {
            return;
        }

        _salvando = true;
        try
        {
            Categoria categoria = _viewModel.ParaEntidade();

            if (_viewModel.EmEdicao)
            {
                bool alterou = await CategoriaService.AlterarAsync(categoria);
                if (!alterou)
                {
                    Snackbar.Add("Esta categoria não existe mais.", Severity.Warning);
                    MudDialog.Cancel();
                    return;
                }

                Snackbar.Add("Categoria atualizada com sucesso!", Severity.Success);
            }
            else
            {
                await CategoriaService.AdicionarAsync(categoria);
                Snackbar.Add("Categoria cadastrada com sucesso!", Severity.Success);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (InvalidOperationException ex)
        {
            // Regra de negócio do serviço (ex.: nome repetido): aviso, não erro
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Erro ao salvar: " + ex.Message, Severity.Error);
        }
        finally
        {
            _salvando = false;
        }
    }

    // Fecha o diálogo sem salvar
    private void Cancelar() => MudDialog.Cancel();
}
