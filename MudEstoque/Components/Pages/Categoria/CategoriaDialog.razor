@inject ICategoriaService CategoriaService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@(_viewModel.EmEdicao ? Icons.Material.Outlined.Edit : Icons.Material.Outlined.AddCircleOutline)"
                     Color="Color.Primary"
                     Size="Size.Small" />
            <MudText Typo="Typo.h6">
                @(_viewModel.EmEdicao ? "Editar Categoria" : "Nova Categoria")
            </MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        @if (_editContext is null)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
        }
        else
        {
            <EditForm EditContext="_editContext" OnValidSubmit="SalvarAsync">
                <DataAnnotationsValidator />

                <MudTextField Label="Nome"
                              @bind-Value="_viewModel.Nome"
                              For="@(() => _viewModel.Nome)"
                              MaxLength="100"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Class="mb-3" />

                <MudTextField Label="Descrição"
                              @bind-Value="_viewModel.Descricao"
                              For="@(() => _viewModel.Descricao)"
                              Lines="3"
                              MaxLength="500"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Class="mb-3" />

                <MudCheckBox @bind-Value="_viewModel.Ativo"
                             Label="Categoria ativa"
                             Color="Color.Primary"
                             Dense="true" />
            </EditForm>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancelar"
                   Disabled="_salvando"
                   Size="Size.Small">
            Cancelar
        </MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Size="Size.Small"
                   Disabled="@(_salvando || _editContext is null)"
                   OnClick="SalvarAsync">
            @if (_salvando)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <span class="ms-2">Salvando...</span>
            }
            else
            {
                <span>Salvar</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public int Id { get; set; }

    private CategoriaViewModel _viewModel = new();
    private EditContext? _editContext;
    private bool _salvando;

    protected override async Task OnInitializedAsync()
    {
        if (Id != 0)
        {
            Categoria? categoria = await CategoriaService.ObterPorIdAsync(Id);
            if (categoria is null)
            {
                Snackbar.Add("Esta categoria não existe mais.", Severity.Warning);
                MudDialog.Cancel();
                return;
            }

            _viewModel = CategoriaViewModel.DaEntidade(categoria);
        }

        _editContext = new EditContext(_viewModel);
    }

    private async Task SalvarAsync()
    {
        if (_editContext is null || _salvando || !_editContext.Validate()) return;

        _salvando = true;
        try
        {
            Categoria categoria = _viewModel.ParaEntidade();

            if (_viewModel.EmEdicao)
            {
                bool alterou = await CategoriaService.AlterarAsync(categoria);
                if (!alterou)
                {
                    Snackbar.Add("Esta categoria não existe mais.", Severity.Warning);
                    MudDialog.Cancel();
                    return;
                }
                Snackbar.Add("Categoria atualizada com sucesso!", Severity.Success);
            }
            else
            {
                await CategoriaService.AdicionarAsync(categoria);
                Snackbar.Add("Categoria cadastrada com sucesso!", Severity.Success);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Erro ao salvar: " + ex.Message, Severity.Error);
        }
        finally
        {
            _salvando = false;
        }
    }

    private void Cancelar() => MudDialog.Cancel();
}
